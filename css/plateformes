/* =========================================================
   PAGE PLATEFORMES
   DATABASE / CLASSIFICATION PLATFORMS
   ========================================================= */

.platforms-header {
    position: relative;

    margin-bottom: 35px;

    padding: 30px 32px 35px;

    border: 1px solid var(--color-border);

    border-left: 3px solid var(--color-cyan);

    background:
        linear-gradient(
            135deg,
            rgba(0, 229, 255, 0.045),
            rgba(5, 9, 20, 0.45)
        );

    box-shadow:
        inset 0 0 40px rgba(0, 229, 255, 0.025),
        var(--glow-cyan);

    overflow: hidden;
}


.platforms-header::before {
    content: "";

    position: absolute;

    top: -80px;
    right: -40px;

    width: 220px;
    height: 220px;

    border: 1px solid rgba(0, 229, 255, 0.08);

    border-radius: 50%;

    box-shadow:
        0 0 0 25px rgba(0, 229, 255, 0.015),
        0 0 0 50px rgba(0, 229, 255, 0.01);

    pointer-events: none;
}


.platforms-header::after {
    content: "";

    position: absolute;

    left: 0;
    bottom: 0;

    width: 100%;
    height: 1px;

    background:
        linear-gradient(
            90deg,
            var(--color-cyan),
            transparent 75%
        );

    box-shadow:
        0 0 12px rgba(0, 229, 255, 0.6);

    pointer-events: none;
}


/* =========================================================
   LIGNE SUPÉRIEURE
   ========================================================= */

.platforms-header-topline {
    display: flex;

    justify-content: space-between;

    gap: 20px;

    margin-bottom: 30px;

    color: var(--color-text-muted);

    font-size: 0.65rem;

    font-weight: 700;

    letter-spacing: 0.18em;
}


/* =========================================================
   LABEL
   ========================================================= */

.platforms-header .section-label {
    display: block;

    margin-bottom: 12px;

    color: var(--color-cyan);

    font-size: 0.55rem;

    font-weight: 800;

    letter-spacing: 0.18em;
}


/* =========================================================
   TITRE PRINCIPAL
   ========================================================= */

.platforms-header h1 {
    position: relative;

    margin-bottom: 20px;

    color: var(--color-white);

    font-size: clamp(
        3rem,
        7vw,
        5.5rem
    );

    line-height: 0.95;

    letter-spacing: -0.04em;

    text-shadow:
        0 0 15px rgba(0, 229, 255, 0.35),
        0 0 45px rgba(0, 229, 255, 0.12);

    z-index: 1;
}


/* =========================================================
   INTRODUCTION HEADER
   ========================================================= */

.platforms-header-intro {
    max-width: 650px;

    margin-bottom: 25px;

    color: var(--color-text);

    font-size: 1rem;

    line-height: 1.8;
}


/* =========================================================
   STATUT
   ========================================================= */

.platforms-status {
    display: inline-flex;

    align-items: center;

    gap: 10px;

    padding: 7px 12px;

    border: 1px solid rgba(0, 229, 255, 0.25);

    background:
        rgba(0, 229, 255, 0.035);

    color: var(--color-cyan);

    font-size: 0.65rem;

    font-weight: 800;

    letter-spacing: 0.16em;
}


/* =========================================================
   POINT DE STATUT
   ========================================================= */

.platforms-status .status-dot {
    width: 7px;
    height: 7px;

    flex-shrink: 0;

    border-radius: 50%;

    background: var(--color-cyan);

    box-shadow:
        0 0 8px var(--color-cyan);

    animation:
        platforms-pulse 1.8s infinite;
}


@keyframes platforms-pulse {

    0%,
    100% {
        opacity: 1;
    }

    50% {
        opacity: 0.35;
    }

}


/* =========================================================
   VUE D'ENSEMBLE
   ========================================================= */

.platforms-meta {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    margin-bottom: 65px;

    border: 1px solid var(--color-border);

    background:
        rgba(5, 15, 28, 0.8);
}


.platforms-meta > div {
    min-height: 90px;

    padding: 18px 20px;

    border-right:
        1px solid var(--color-border);
}


.platforms-meta > div:last-child {
    border-right: none;
}


.platforms-meta span {
    display: block;

    margin-bottom: 8px;

    color: var(--color-text-muted);

    font-size: 0.55rem;

    font-weight: 800;

    letter-spacing: 0.18em;
}


.platforms-meta strong {
    color: var(--color-cyan);

    font-size: 1rem;

    letter-spacing: 0.08em;
}


/* =========================================================
   DOSSIER PRINCIPAL
   ========================================================= */

.platforms-database {
    width: 100%;
}


/* =========================================================
   INTRODUCTION
   ========================================================= */

.platforms-intro {
    margin-bottom: 60px;

    padding: 30px 35px;

    border: 1px solid var(--color-border);

    border-left: 2px solid var(--color-cyan);

    background:
        linear-gradient(
            145deg,
            rgba(10, 22, 38, 0.65),
            rgba(4, 9, 18, 0.78)
        );
}


.platforms-file-number {
    display: block;

    margin-bottom: 12px;

    color: var(--color-cyan);

    font-size: 0.55rem;

    font-weight: 800;

    letter-spacing: 0.18em;
}


.platforms-intro h2 {
    margin-bottom: 15px;

    color: var(--color-white);

    font-size: clamp(
        1.5rem,
        4vw,
        2.5rem
    );

    letter-spacing: 0.01em;
}


.platforms-intro p {
    max-width: 750px;

    margin: 0;

    color: var(--color-text-muted);

    line-height: 1.7;
}


/* =========================================================
   SECTION DATABASE
   ========================================================= */

.platforms-section {
    position: relative;

    margin-bottom: 60px;

    padding: 35px;

    border: 1px solid var(--color-border);

    border-left: 2px solid var(--color-cyan);

    background:
        linear-gradient(
            145deg,
            rgba(10, 22, 38, 0.65),
            rgba(4, 9, 18, 0.78)
        );

    box-shadow:
        inset 0 0 35px rgba(0, 229, 255, 0.015);

    overflow: hidden;
}


.platforms-section::before {
    content: "";

    position: absolute;

    top: 0;
    right: 0;

    width: 180px;
    height: 1px;

    background:
        linear-gradient(
            90deg,
            transparent,
            var(--color-cyan)
        );

    opacity: 0.5;
}


/* =========================================================
   EN-TÊTE SECTION
   ========================================================= */

.platforms-section-header {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 30px;

    padding-bottom: 25px;

    margin-bottom: 30px;

    border-bottom:
        1px solid var(--color-border);
}


.platforms-section-marker {
    display: flex;

    align-items: center;

    gap: 12px;

    color: var(--color-text);

    font-size: 0.65rem;

    font-weight: 800;

    letter-spacing: 0.14em;
}


.platforms-section-marker span {
    display: flex;

    align-items: center;

    justify-content: center;

    width: 42px;
    height: 42px;

    flex-shrink: 0;

    border:
        1px solid rgba(0, 229, 255, 0.35);

    background:
        rgba(0, 229, 255, 0.04);

    color: var(--color-cyan);

    font-size: 0.65rem;

    font-weight: 800;

    letter-spacing: 0.08em;

    box-shadow:
        0 0 15px rgba(0, 229, 255, 0.05);
}


.platforms-section-status {
    display: flex;

    align-items: center;

    gap: 9px;

    padding: 7px 12px;

    border:
        1px solid var(--color-border);

    color: var(--color-text-muted);

    font-size: 0.55rem;

    font-weight: 800;

    letter-spacing: 0.14em;
}


.platforms-section-status .category-status-dot {
    width: 6px;
    height: 6px;

    flex-shrink: 0;

    border-radius: 50%;

    background: var(--color-cyan);

    box-shadow:
        0 0 7px var(--color-cyan);
}


/* =========================================================
   GRILLE DES PLATEFORMES
   ========================================================= */

.platforms-grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 14px;
}


/* =========================================================
   CARTE PLATEFORME
   ========================================================= */

.platform-card {
    position: relative;

    border:
        1px solid var(--color-border);

    background:
        rgba(2, 8, 16, 0.9);

    overflow: hidden;

    transition:
        transform var(--transition-normal),
        border-color var(--transition-normal),
        box-shadow var(--transition-normal);
}


.platform-card:hover {
    transform:
        translateY(-5px);

    border-color:
        var(--color-border-strong);

    box-shadow:
        0 12px 35px rgba(0, 0, 0, 0.35),
        0 0 25px rgba(0, 229, 255, 0.06);
}


/* =========================================================
   IDENTIFIANT CARTE
   ========================================================= */

.platform-card-top {
    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 10px;

    padding: 10px 12px;

    border-bottom:
        1px solid var(--color-border);

    color:
        var(--color-text-muted);

    font-size: 0.5rem;

    font-weight: 800;

    letter-spacing: 0.12em;
}


.platform-card-top span:last-child {
    color:
        var(--color-cyan);
}


/* =========================================================
   IMAGE PLATEFORME
   ========================================================= */

.platform-card-image {
    position: relative;

    display: flex;

    align-items: center;

    justify-content: center;

    min-height: 220px;

    padding: 20px;

    border-bottom:
        1px solid var(--color-border);

    background:
        radial-gradient(
            circle at center,
            rgba(0, 229, 255, 0.06),
            transparent 65%
        );
}


.platform-card-image::before {
    content: "";

    position: absolute;

    inset: 12px;

    border:
        1px solid rgba(0, 229, 255, 0.035);

    pointer-events: none;
}


.platform-card-image::after {
    content: "";

    position: absolute;

    top: 50%;
    left: 50%;

    width: 70%;
    height: 70%;

    transform:
        translate(-50%, -50%);

    background:
        radial-gradient(
            circle,
            rgba(0, 229, 255, 0.035),
            transparent 65%
        );

    pointer-events: none;
}


.platform-card-image img {
    position: relative;

    z-index: 1;

    display: block;

    width: 100%;

    max-width: 210px;

    height: 190px;

    object-fit: contain;

    filter:
        drop-shadow(
            0 0 18px
            rgba(0, 229, 255, 0.12)
        );

    transition:
        transform 0.4s ease,
        filter 0.4s ease;
}


.platform-card:hover
.platform-card-image img {
    transform:
        scale(1.08);

    filter:
        drop-shadow(
            0 0 25px
            rgba(0, 229, 255, 0.3)
        );
}


/* =========================================================
   INFORMATIONS CARTE
   ========================================================= */

.platform-card-info {
    display: flex;

    flex-direction: column;

    gap: 5px;

    padding: 16px 18px;
}


.platform-card-info span {
    color:
        var(--color-text-muted);

    font-size: 0.5rem;

    font-weight: 800;

    letter-spacing: 0.18em;
}


.platform-card-info strong {
    color:
        var(--color-cyan);

    font-size: 0.8rem;

    letter-spacing: 0.08em;
}


/* =========================================================
   MARQUAGE SUPÉRIEUR DE CARTE
   ========================================================= */

.platform-card::after {
    content: "";

    position: absolute;

    top: 0;
    left: 0;

    width: 35px;
    height: 1px;

    background:
        var(--color-cyan);

    box-shadow:
        0 0 8px rgba(0, 229, 255, 0.5);

    opacity: 0.5;

    transition:
        width var(--transition-normal),
        opacity var(--transition-normal);
}


.platform-card:hover::after {
    width: 100%;

    opacity: 0.9;
}


/* =========================================================
   FIN — PAGE PLATEFORMES
   ========================================================= */
